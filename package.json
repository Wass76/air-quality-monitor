{
  "name": "air-quality-monitor",
  "version": "0.0.1",
  "description": "Event-driven air quality monitoring across GCC cities (Collector + Processor)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build collector && nest build processor",
    "build:collector": "nest build collector",
    "build:processor": "nest build processor",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:collector": "nest start collector",
    "start:processor": "nest start processor",
    "start:collector:dev": "nest start collector --watch",
    "start:processor:dev": "nest start processor --watch",
    "start:dev": "nest start collector --watch",
    "start:prod:collector": "node dist/apps/collector/main",
    "start:prod:processor": "node dist/apps/processor/main",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.build.json",
    "test": "jest --config jest.unit.config.js --runInBand",
    "test:unit": "jest --config jest.unit.config.js --runInBand",
    "test:watch": "jest --config jest.unit.config.js --watch",
    "test:cov": "jest --config jest.unit.config.js --coverage --runInBand",
    "test:ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "smoke": "node scripts/smoke-compose.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "6.19.3",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "axios": "^1.18.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
