# syntax=docker/dockerfile:1

FROM node:20-alpine AS builder
WORKDIR /app

RUN apk add --no-cache openssl

COPY package*.json ./
COPY nest-cli.json tsconfig.json tsconfig.build.json ./
COPY prisma ./prisma
COPY apps ./apps
COPY libs ./libs

RUN npm ci --prefer-offline --no-audit
RUN ./node_modules/.bin/prisma generate \
 && ./node_modules/.bin/nest build processor \
 && npm prune --omit=dev

FROM node:20-alpine AS runner
WORKDIR /app

RUN apk add --no-cache openssl

ENV NODE_ENV=production
ENV PORT=3002

COPY prisma ./prisma
COPY docker/processor-entrypoint.sh ./docker/processor-entrypoint.sh
RUN sed -i 's/\r$//' ./docker/processor-entrypoint.sh \
 && chmod +x ./docker/processor-entrypoint.sh

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3002
ENTRYPOINT ["sh", "./docker/processor-entrypoint.sh"]
