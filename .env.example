# Air quality data source: "mock" (no Google billing) or "google"
AQI_PROVIDER=mock
# Required only when AQI_PROVIDER=google — never commit a real key
GOOGLE_AQI_API_KEY=your_google_api_key_here
# Cities that exceed thresholds in mock mode (comma-separated)
# Include Muscat to exercise UAQI lower-is-worse fallback
MOCK_CRITICAL_CITIES=Dubai,Doha,Muscat

# Local AQI code forced via customLocalAqis (usa_epa for GCC)
LOCAL_AQI_CODE=usa_epa
# UAQI fallback floor (lower-is-worse): alert when UAQI < this value
UAQI_CRITICAL_FLOOR=40
# Hysteresis recovery bands (optional)
LAQI_RECOVERY=90
UAQI_RECOVERY_FLOOR=50
PM25_RECOVERY=90
PM10_RECOVERY=135

# Postgres
POSTGRES_USER=aqi
POSTGRES_PASSWORD=aqi_secret
POSTGRES_DB=air_quality
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aqi:aqi_secret@localhost:5432/air_quality?schema=public

# RabbitMQ
RABBITMQ_USER=aqi
RABBITMQ_PASSWORD=aqi_secret
RABBITMQ_URL=amqp://aqi:aqi_secret@localhost:5672
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Services
COLLECTOR_PORT=3001
PROCESSOR_PORT=3002
PORT=3001

# Collector behaviour
POLL_INTERVAL_MS=10000
ALERT_COOLDOWN_MS=300000
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20

# Logging
NODE_ENV=development
LOG_TO_FILE=false
